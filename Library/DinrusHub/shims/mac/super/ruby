#!/bin/bash

# System Ruby's mkmf on Mojave (10.14) and later require SDKROOT set to work correctly.

# DRXHUB_LIBRARY is set by bin/dhub
# DRXHUB_SDKROOT is set by extend/ENV/super.rb
# shellcheck disable=SC2154
source "${DRXHUB_LIBRARY}/DinrusHub/shims/utils.sh"

try_exec_non_system "${SHIM_FILE}" "$@"

if [[ -z "${SDKROOT}" && -n "${DRXHUB_SDKROOT}" ]]
then
  export SDKROOT="${DRXHUB_SDKROOT}"
fi

safe_exec "/usr/bin/${SHIM_FILE}" "$@"
