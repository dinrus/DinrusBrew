#!/bin/bash

# DRXHUB_OPT and DRXHUB_SDKROOT are set by extend/ENV/super.rb
# shellcheck disable=SC2154
pkg_config="${DRXHUB_OPT}/pkg-config/bin/pkg-config"

if [[ -z "${DRXHUB_SDKROOT}" ]]
then
  exec "${pkg_config}" "$@"
fi

exec "${pkg_config}" \
  "--define-variable=homebrew_sdkroot=${DRXHUB_SDKROOT}" \
  "$@"
