#!/bin/bash

# DRXHUB_LIBRARY is set by bin/dhub
# DRXHUB_CCCFG and DRXHUB_OPT are set by extend/ENV/super.rb
# shellcheck disable=SC2154
if [[ -z "${DRXHUB_LIBRARY}" ]]
then
  echo "${0##*/}: This shim is internal and must be run via dhub." >&2
  exit 1
fi

source "${DRXHUB_LIBRARY}/DinrusHub/shims/utils.sh"

parallel_args=()
if [[ -n "${DRXHUB_MAKE_JOBS}" ]]
then
  parallel_args+=(-j "${DRXHUB_MAKE_JOBS}")
fi

# shellcheck disable=SC2154
export DRXHUB_CCCFG="O${DRXHUB_CCCFG}"
try_exec_non_system "ninja" "${parallel_args[@]}" "$@"

echo "ninja: Shim failed to find ninja in PATH."
exit 1
