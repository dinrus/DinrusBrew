#!/bin/bash

# Ensure we use Swift's clang when performing Swift builds.

export CC="clang"
export CXX="clang++"

# swift_clang isn't a shim but is used to ensure the cc shim
# points to the compiler inside the swift keg
export DRXHUB_CC="swift_clang"
export DRXHUB_CXX="swift_clang++"

# DRXHUB_OPT is set by extend/ENV/super.rb
# shellcheck disable=SC2154
exec "${DRXHUB_OPT}/swift/bin/${0##*/}" "$@"
